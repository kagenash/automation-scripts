{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Testar sintaxe dos scripts",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tests/test_syntax.ps1"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Executar script atual (PowerShell)",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${file}"],
            "problemMatcher": []
        }
    ]
}
